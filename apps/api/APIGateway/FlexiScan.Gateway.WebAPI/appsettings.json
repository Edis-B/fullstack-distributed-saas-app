{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FrontendUrl": "https://localhost:5173",
  "ReverseProxy": {
    "Routes": {
      "UsersRoute": {
        "ClusterId": "UsersCluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      },
      "SubscriptionsRoute": {
        "ClusterId": "SubscriptionsCluster",
        "Match": {
          "Path": "/api/subscriptions/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "UsersCluster": {
        "Destinations": {
          "UsersApiDestination": {
            "Address": "https://localhost:7136"
          }
        }
      },
      "SubscriptionsCluster": {
        "Destinations": {
          "SubscriptionsApiDestination": {
            "Address": "https://localhost:7140"
          }
        }
      }
    }
  }
}
